# ===== 必填 =====
# 临时邮箱域名（支持多域名，逗号分隔）
# MX 记录应指向本服务器 IP（SMTP 模式）或 Cloudflare（IMAP 模式）
MAIL_DOMAIN=muskqq.com,example.com

# 管理 API 密钥。生成：openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# ===== 收信方式 =====
# 推荐：自建 SMTP（直接收信，不依赖外部中转邮箱）
# 可选：IMAP / Graph 拉取中转邮箱（兼容旧架构）
# 可选：Webhook 推送

# ---------- 自建 SMTP（推荐）----------
# 启用内置 SMTP 服务器，直接接收 @MAIL_DOMAIN 的邮件
# DNS 需要：MX 记录指向本服务器 IP，开放 25 端口
SMTP_ENABLED=true
SMTP_ADDR=:25
# SMTP_HOSTNAME=mail.example.com  # 默认等于 MAIL_DOMAIN

# ---------- IMAP：Firstmail 预设（兼容旧架构）----------
# 自动填充 Host=imap.firstmail.ltd Port=993 TLS=true
# IMAP_PROVIDER=firstmail
# IMAP_USER=your-account@your-firstmail-domain.com
# IMAP_PASS=your-password
# IMAP_MAILBOX=INBOX
# IMAP_AUTH_MODE=plain

# ---------- IMAP：手写（Gmail 等）----------
# IMAP_PROVIDER=
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_TLS=true
# IMAP_STARTTLS=false
# IMAP_TLS_INSECURE=false
# IMAP_USER=your-relay@gmail.com
# IMAP_PASS=your-app-password
# IMAP_MAILBOX=INBOX
# IMAP_AUTH_MODE=plain

# ---------- IMAP：Outlook OAuth2（可选；个人号不稳请改 Graph）----------
# IMAP_HOST=outlook.office365.com
# IMAP_PORT=993
# IMAP_TLS=true
# IMAP_AUTH_MODE=oauth2
# IMAP_USER=your@outlook.com
# IMAP_CLIENT_ID=your-azure-app-client-id
# IMAP_TENANT_ID=consumers
# IMAP_REFRESH_TOKEN=your-refresh-token
# IMAP_TOKEN_SCOPE=https://outlook.office.com/IMAP.AccessAsUser.All offline_access

# ---------- Microsoft Graph（个人 Outlook 推荐）----------
# GRAPH_ENABLED=true
# GRAPH_CLIENT_ID=your-azure-app-client-id
# GRAPH_CLIENT_SECRET=your-azure-app-secret
# GRAPH_TENANT_ID=common
# GRAPH_ACCOUNT=your-relay@outlook.com
# GRAPH_REFRESH_TOKEN=your-refresh-token
# GRAPH_TOKEN_SCOPE=offline_access Mail.Read Mail.ReadWrite User.Read
# GRAPH_MAIL_FOLDER=
# 获取 token：python tools/get_graph_token.py
# 注意：refresh_token 会轮换并写回本文件，不要多实例并发

# ---------- 可选 Webhook（备用推送入口）----------
# WEBHOOK_SECRET=change-me-to-another-long-random-string

# ===== 服务可选 =====
LISTEN_ADDR=:8080
DB_PATH=./data/tempmail.db
DEFAULT_TTL_HOURS=24
CLEANUP_INTERVAL_MIN=30

# 入站消息保留时长（小时）；0 = 关闭按年龄清理（仍按邮箱过期清理）
MESSAGE_TTL_HOURS=24

# 允许随机子域名邮箱
# SUBDOMAIN_ENABLED=true

# ===== 发信（可选）=====
# 外部 SMTP 中继。留空则直连收件人 MX（需本机可出 25 端口）
# SMTP_SEND_HOST=smtp.example.com
# SMTP_SEND_PORT=587
# SMTP_SEND_USER=
# SMTP_SEND_PASS=
# SMTP_SEND_STARTTLS=true
# SMTP_SEND_FROM=noreply@yourdomain.com

# 历史兼容字段（按需拉取模式下主要用于文档/连续 Run；一般无需改）
# IMAP_POLL_INTERVAL_SEC=1
# GRAPH_POLL_INTERVAL_SEC=1
