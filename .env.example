# ===== Required =====
# 你的域名（已托管在 Cloudflare 并开启 Email Routing）。
MAIL_DOMAIN=mail.example.com

# 管理 API 鉴权密钥。生成：openssl rand -hex 32
API_KEY=change-me-to-a-long-random-string

# ===== IMAP 收信（推荐，不消耗 Cloudflare Worker 次数）=====
# Cloudflare Email Routing 把 *@yourdomain 的邮件 catch-all 转发到一个真实
# 邮箱（如 Gmail / Outlook / 自建邮箱），由本服务通过 IMAP 拉取。
# 以 Gmail 为例：
#   IMAP_HOST   = imap.gmail.com
#   IMAP_USER   = your-relay-account@gmail.com
#   IMAP_PASS   = 应用专用密码（非登录密码），在 Google 账户里生成
#   IMAP_PORT   = 993  IMAP_TLS=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your-relay-account@gmail.com
IMAP_PASS=your-app-password
IMAP_MAILBOX=INBOX
IMAP_TLS=true
# 轮询间隔（秒）。默认 60 秒；越短越实时但越频繁连接邮箱。
IMAP_POLL_INTERVAL_SEC=15

# ===== Outlook OAuth2 / Modern Auth =====
# Outlook.com 通常需要 OAuth2。把 IMAP_AUTH_MODE 设为 oauth2 后填写下列字段。
# IMAP_AUTH_MODE=oauth2
# IMAP_CLIENT_ID=your-azure-app-client-id
# IMAP_TENANT_ID=consumers
# IMAP_REFRESH_TOKEN=your-refresh-token

# ===== Graph API 收信（推荐，对个人 Outlook 账号比 IMAP OAuth2 更稳）=====
# 个人 Outlook 账号走 IMAP OAuth2 常报 "User is authenticated but not connected"。
# Graph 模式直接用 Microsoft Graph 读邮件，绕开 IMAP。设置 GRAPH_ENABLED=true
# 即启用 Graph poller，IMAP 配置将被忽略。需要 Azure 应用已授予
# Microsoft Graph 委托权限 Mail.Read / Mail.ReadWrite / offline_access。
# GRAPH_ENABLED=true
# GRAPH_CLIENT_ID=your-azure-app-client-id
# GRAPH_CLIENT_SECRET=your-azure-app-secret
# GRAPH_TENANT_ID=common
# GRAPH_ACCOUNT=your-relay@outlook.com
# GRAPH_REFRESH_TOKEN=your-refresh-token
# GRAPH_TOKEN_SCOPE=offline_access Mail.Read Mail.ReadWrite User.Read
# GRAPH_MAIL_FOLDER=
# GRAPH_POLL_INTERVAL_SEC=10

# ===== 可选：Webhook 收信入口（不配置即禁用）=====
# 仅当你想用 Email Worker 推送（会消耗 Worker 次数）时才需要。
# 留空则 /api/webhook/email 返回 503，IMAP 是唯一收信入口。
# WEBHOOK_SECRET=change-me-to-another-long-random-string

# ===== Optional =====
LISTEN_ADDR=:8080
DB_PATH=./data/tempmail.db
DEFAULT_TTL_HOURS=24
CLEANUP_INTERVAL_MIN=30
